# Required: create your own key at the DeepSeek platform.
DEEPSEEK_API_KEY=replace-with-your-own-key

# Current OpenAI-compatible DeepSeek defaults.
BLUEWHALE_MODEL=deepseek-v4-pro
BLUEWHALE_BASE_URL=https://api.deepseek.com

# Live contract tests remain disabled unless explicitly changed to 1.
BLUEWHALE_RUN_LIVE_TESTS=0
