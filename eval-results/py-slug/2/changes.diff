@@ -7,6 +7,16 @@
     def test_collapses_spaces(self) -> None:
         self.assertEqual(slugify("Blue  Whale"), "blue-whale")
 
+    def test_lowercase(self) -> None:
+        self.assertEqual(slugify("Hello WORLD"), "hello-world")
+
+    def test_collapses_punctuation(self) -> None:
+        self.assertEqual(slugify("Hello, World!"), "hello-world")
