--- /dev/null
+++ b/extra_check.cpp
@@ -0,0 +1,26 @@
+#include <cassert>
+#include <stdexcept>
+#include <vector>
+
+double median(const std::vector<double>& values);
+
+int main() {
+    // empty must throw invalid_argument
+    bool threw = false;
+    try {
+        median(std::vector<double>{});
+    } catch (const std::invalid_argument&) {
+        threw = true;
+    }
+    assert(threw);
+
+    // input must not be modified
+    std::vector<double> in{7, 1, 3, 9};
+    const auto copy = in;
+    assert(median(in) == 5.0);
+    assert(in == copy);
+
+    // odd length with unsorted input
+    std::vector<double> odd{5, 1, 3};
+    assert(median(odd) == 3.0);
+}
--- a/stats.cpp
+++ b/stats.cpp
@@ -1,7 +1,14 @@
+#include <algorithm>
 #include <stdexcept>
 #include <vector>
 
 double median(const std::vector<double>& values) {
     if (values.empty()) throw std::invalid_argument("empty values");
-    return values[values.size() / 2];
+    std::vector<double> sorted = values;
+    std::sort(sorted.begin(), sorted.end());
+    const std::size_t n = sorted.size();
+    if (n % 2 == 0) {
+        return (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0;
+    }
+    return sorted[n / 2];
 }
