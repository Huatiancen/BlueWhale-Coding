--- a/stats.cpp
+++ b/stats.cpp
@@ -1,7 +1,14 @@
+#include <algorithm>
 #include <stdexcept>
 #include <vector>
 
 double median(const std::vector<double>& values) {
     if (values.empty()) throw std::invalid_argument("empty values");
-    return values[values.size() / 2];
+    std::vector<double> copy = values;
+    std::sort(copy.begin(), copy.end());
+    const std::size_t n = copy.size();
+    if (n % 2 == 0) {
+        return (copy[n / 2 - 1] + copy[n / 2]) / 2.0;
+    }
+    return copy[n / 2];
 }
--- /dev/null
+++ b/verify.cpp
@@ -0,0 +1,24 @@
+#include <cassert>
+#include <stdexcept>
+#include <vector>
+
+double median(const std::vector<double>& values);
+
+int main() {
+    std::vector<double> even{9, 1, 7, 3};
+    assert(median(even) == 5.0);
+    assert((even == std::vector<double>{9, 1, 7, 3})); // input unchanged
+
+    std::vector<double> odd{7, 1, 3};
+    assert(median(odd) == 3.0);
+    assert((odd == std::vector<double>{7, 1, 3}));
+
+    bool threw = false;
+    try {
+        median(std::vector<double>{});
+    } catch (const std::invalid_argument&) {
+        threw = true;
+    }
+    assert(threw);
+    return 0;
+}
