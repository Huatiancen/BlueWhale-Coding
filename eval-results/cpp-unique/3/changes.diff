+#include <cassert>
+#include <vector>
+
+std::vector<int> unique_preserving_order(const std::vector<int>& values);
+
+int main() {
+    {
+        std::vector<int> in{3, 1, 2, 1, 3, 4, 2};
+        std::vector<int> orig = in;
+        assert((unique_preserving_order(in) == std::vector<int>{3, 1, 2, 4}));
+        assert(in == orig);  // input not modified
+    }
+    {
+        std::vector<int> in{1, 1, 1};
+        assert((unique_preserving_order(in) == std::vector<int>{1}));
+    }
+    {
+        std::vector<int> in;
+        assert(unique_preserving_order(in).empty());
+    }
+    assert((unique_preserving_order({1, 2, 1, 3}) == std::vector<int>{1, 2, 3}));
